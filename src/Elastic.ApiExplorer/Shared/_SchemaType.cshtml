@using Elastic.ApiExplorer.Schema
@using Microsoft.AspNetCore.Html
@inherits RazorSlice<Elastic.ApiExplorer.Schema.SchemaTypeContext>
@{
	var typeInfo = Model?.TypeInfo;
	var sb = new System.Text.StringBuilder();

	if (typeInfo != null)
	{
		var typeName = typeInfo.TypeName ?? "";

		// Standard primitive type names — shown as-is
		var standardPrimitives = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
			{ "string", "integer", "boolean", "number", "null", "object", "array" };

		// OpenAPI structural keywords — never shown to readers
		var structuralKeywords = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
			{ "anyOf", "oneOf", "allOf", "unknown", "enum" };

		// "array" prefix for arrays
		if (typeInfo.IsArray)
			sb.Append("<span class=\"array-icon\">array</span> ");

		if (typeInfo.IsDictionary)
		{
			// "map string to X" — distinctly useful, keep as-is
			var valueTypeName = typeName.StartsWith("string to ") ? typeName["string to ".Length..] : typeName;
			if (string.IsNullOrEmpty(valueTypeName)) valueTypeName = "object";
			sb.Append("<span class=\"map-keyword\">map string to </span>");
			sb.Append("<span>");
			sb.Append(System.Web.HttpUtility.HtmlEncode(valueTypeName));
			sb.Append("</span>");
		}
		else
		{
			// Resolve a single display type name — no badges, no prefixes
			string? display = null;

			if (typeInfo.IsEnum || typeInfo.IsUnion || structuralKeywords.Contains(typeName))
			{
				// Enum values and union variants are shown in the detail sections below — nothing needed here
				display = null;
			}
			else if (typeInfo.IsValueType && !string.IsNullOrEmpty(typeInfo.ValueTypeBase))
			{
				// Value types (IndexName, Field, …) → show the underlying primitive
				display = typeInfo.ValueTypeBase;
			}
			else if (typeInfo.HasLink)
			{
				// Linked types have dedicated pages — the name is meaningful
				display = typeName;
			}
			else if (standardPrimitives.Contains(typeName))
			{
				display = typeName;
			}
			else if (typeInfo.IsObject)
			{
				// Named schema objects — internal names add noise, "object" is enough
				display = "object";
			}
			else if (!string.IsNullOrEmpty(typeName))
			{
				display = typeName;
			}

			if (!string.IsNullOrEmpty(display))
			{
				sb.Append("<span>");
				sb.Append(System.Web.HttpUtility.HtmlEncode(display));
				sb.Append("</span>");
			}
		}
	}

	var result = sb.ToString();
}
<code class="schema-type">@(new HtmlString(result))</code>
